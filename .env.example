# =============================================================================
# AI Intelligence Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_intelligence_pipeline

# --- LLM API Keys & Models ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DAILY_REQUEST_LIMIT=50
OPENROUTER_RPM_LIMIT=20

LLM_PRIMARY_PROVIDER=openrouter
LLM_FALLBACK_PROVIDERS=gemini,groq,deepseek

# --- LLM Orchestrator Config ---
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=2.0
LLM_BACKOFF_MAX=30.0
LLM_CONCURRENCY=5
LLM_MAX_INPUT_CHARS=12000

# --- GitHub ---
GITHUB_TOKEN=your_github_token_here

# --- Google Sheets ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_SHEETS_BATCH_SIZE=500

# --- Multi-Source Configurations ---
NEWS_SOURCES=techcrunch,venturebeat,mit_tech_review,hackernews,kdnuggets
JOBS_SOURCES=arbeitnow,remoteok,jobicy,weworkremotely
STARTUP_SOURCES=github_orgs
PRODUCT_SOURCES=github_repos

